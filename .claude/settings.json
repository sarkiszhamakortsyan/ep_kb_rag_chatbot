{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/export_ai_logs.py\" --hook 2>/dev/null || true",
            "timeout": 60,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/export_ai_logs.py\" --hook 2>/dev/null || true",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
