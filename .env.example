# Copy to .env and adjust. Never commit .env or real API keys.

# --- Docker Compose -------------------------------------------------------
# Host port of the web UI
FRONTEND_PORT=8080

# --- LLM providers ---------------------------------------------------------
# Chat provider used by default: ollama | anthropic
LLM_PROVIDER=ollama
# Comma-separated list of providers that may be used (idea #7: enable/disable models)
ENABLED_LLM_PROVIDERS=ollama,anthropic
# Embedding provider (Anthropic has no embeddings API): ollama
EMBEDDING_PROVIDER=ollama

# --- Ollama ----------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
# Chat model: ministral-3:3b is the best speed/quality trade-off on a CPU (16/18, about 60 s);
# qwen3.5:4b answers slightly better but takes about 2 minutes (set OLLAMA_THINK=false for it).
# Comparison: documentation/evaluation.md
OLLAMA_CHAT_MODEL=ministral-3:3b
OLLAMA_EMBED_MODEL=embeddinggemma
# Context window; must fit the system prompt + retrieved chunks + question
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=30m
# Leave empty for models without a thinking mode; set false for qwen3.5 etc.
OLLAMA_THINK=
# Max seconds to wait for the first token (a RAG prompt on a slow CPU can take minutes).
# Keep it below nginx's proxy_read_timeout (900 s, frontend/nginx.conf).
OLLAMA_TIMEOUT_S=300

# --- Anthropic (bring your own key) ----------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Optional: low | medium | high | xhigh | max (empty = API default)
ANTHROPIC_EFFORT=
# Re-run safety-classifier refusals on Anthropic's recommended fallback model
# (set false for models that don't support server-side fallback)
ANTHROPIC_REFUSAL_FALLBACK=true

# --- Retrieval -------------------------------------------------------------
# Chunk window and overlap, in words (~1.3 tokens per word)
CHUNK_MAX_WORDS=300
CHUNK_OVERLAP_WORDS=45
# Number of chunks retrieved for the LLM (6 covers two-document questions; see steps.md Phase 4)
TOP_K=6
# Below this cosine similarity the question is treated as "not covered by the docs".
# Calibrated for embeddinggemma: answerable >= 0.42, off-topic <= 0.18 (see storage.md)
MIN_SCORE=0.35

# --- API -------------------------------------------------------------------
# Origins allowed to call the API from a browser (Vite dev server); comma-separated
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# --- Admin area (/admin: history, ...) ----------------------------------------
# Disabled when empty. Use a long random value, e.g. `openssl rand -hex 24`.
ADMIN_TOKEN=

# --- Response history (stored in SQLite, shown in the admin area) -----------
# Questions and answers can contain customer data: keep them only as long as needed.
HISTORY_ENABLED=true
HISTORY_RETENTION_DAYS=90

# --- Costs tab ------------------------------------------------------------------
# Price overrides in USD per million tokens (defaults: Claude list prices), as JSON:
# MODEL_PRICES={"claude-opus-5": {"input": 5, "output": 25, "cache_read": 0.5, "cache_write": 6.25}}
MODEL_PRICES={}
# Optional cost of running the local model (e.g. a GPU server's hourly price, USD)
LOCAL_COST_PER_HOUR=0
